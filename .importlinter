; G2 GP-5 2차 PoC — Provider Adapter Enforcement Layer 1 (T-2 import-linter)
;
; 답습 출처:
;   - docs/architecture/llm-providers-design.md §9.3 (allow path / forbidden path 시제 의도)
;   - docs/review/3plus1-consensus-2026-05-10-g2-gp5-poc2-depcruise-full.md §5.2
;   - docs/phase0/g2-gp5-poc2-depcruise-rule-scope.md §2.1, §3.1
;
; 책무 분담 (litellm facade 부분 = 3+1 합의 2026-05-29 MT-6 정정):
;   - 본 룰: 4종 (openai, anthropic, litellm, ollama) direct/from/transitive 차단
;   - google.generativeai: 1차 AST scanner 단독 책무 (각주 1 — import-linter 제약 답습)
;   - 동적 import (importlib, __import__): 1차 AST scanner 전담 (책무 분리)
;   - 모델명 분기 (문자열): 1차 AST scanner 전담
;   - litellm 정적 direct/from: import-linter + 1차 AST scanner 가 *모두* 검사하되,
;     양쪽 다 facade(src/adapters/llm/facade.py)는 면제(Provider Liquidity 단일 통로,
;     ADR-009 §2.2 #1 / PoC §2.4 white-list / design §9.3 pathNot:facade).
;     facade 외 litellm·동적 litellm 은 계속 검출 (docs/review/3plus1-consensus-2026-05-29-facade-scanner.md).
;   - URL/endpoint 하드코딩: 3차 별도 합의 영역 외
;   - 의미적 lock-in: 라운드트립 검증 (P2-5) 영역 외
;
; 핵심 옵션 — include_external_packages = True:
;   forbidden 모듈 미설치 환경에서도 정상 검출 (C-9 RA-9 사전 검증 PASS, 2026-05-10).

[importlinter]
root_packages =
    src
include_external_packages = True

[importlinter:contract:no-direct-llm-sdk]
name = No direct LLM SDK imports outside facade
type = forbidden
source_modules =
    src
forbidden_modules =
    openai
    anthropic
    litellm
    ollama
ignore_imports =
    src.adapters.llm.facade -> *

; ── 디딤돌1a BL-8 (3+1 합의 2026-05-29) ──────────────────────────────────────
; plan-then-execute 단방향 경계: plan_controller > orchestrator > boss.
; boss(untrusted planner)는 상위(orchestrator/plan_controller)를 import 할 수
; 없다 — boss 출력이 제어흐름을 역류시키는 경로의 정적 차단(BL-1/§6.1 means/ends
; 경계의 *센서*. brief v1 은 이 경계가 "유지된다"고 over-claim 했으나 실재하지
; 않았음 → 신규 추가). 답습: docs/phase0/jarvis-stone1a-plan-then-execute-
; design-brief.md §6(d)·§9 / docs/review/3plus1-consensus-2026-05-29-jarvis-
; stone1a-plan-then-execute.md (GP-2).
[importlinter:contract:jarvis-orchestration-layers]
name = Jarvis orchestration single-direction (boss < orchestrator < plan_controller)
type = layers
layers =
    src.jarvis.plan_controller
    src.jarvis.orchestrator
    src.jarvis.boss
